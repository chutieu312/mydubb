# MyDubb configuration. PLACEHOLDERS ONLY - never commit real values.
# Local development: copy to backend/.env (read by the backend from its working directory).
# Docker Compose: only ACCESS_CODE is read from your shell or a root .env file.

# development | test | production
APP_ENV=development

# PostgreSQL only (no SQLite fallback). Neon URLs (postgresql://...?sslmode=require) work as-is.
# Use 127.0.0.1 rather than localhost on Windows (avoids IPv6 resolution to ::1).
DATABASE_URL=postgresql://mydubb:mydubb_local@127.0.0.1:5432/mydubb
DB_CONNECT_TIMEOUT_SECONDS=10

# Sign-in mode: access_code (default) | cognito. Exclusive: each mode serves only its own login
# endpoints and accepts only its own sessions. See docs/AUTHENTICATION.md.
AUTH_MODE=access_code

# Private Beta Access Code (server-side only). Required with AUTH_MODE=access_code (ignored with
# cognito). >= 8 chars; >= 16 chars in production.
ACCESS_CODE=replace-with-a-long-random-code

# --- Amazon Cognito (only read when AUTH_MODE=cognito; startup fails if one is missing) ---
# The backend calls only public user pool operations: no AWS access key is needed.
# COGNITO_REGION=us-west-2
# COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
# COGNITO_CLIENT_ID=
# Secret of the confidential app client (recommended). Secret: never commit it.
# COGNITO_CLIENT_SECRET=
# 32 random bytes, URL-safe base64; encrypts the Cognito material of pending sign-in steps.
# Generate: python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# AUTH_TOKEN_ENCRYPTION_KEY=
# COGNITO_TIMEOUT_SECONDS=10
# Keep at or below the app client's authentication flow session duration (default 3 minutes).
# AUTH_NEW_PASSWORD_CHALLENGE_TTL_SECONDS=180
# Keep below the access token lifetime (default 60 minutes).
# AUTH_EMAIL_VERIFICATION_CHALLENGE_TTL_SECONDS=900
# Password recovery / verification-code requests per window (every request counts).
# AUTH_RECOVERY_MAX_PER_CLIENT=5
# AUTH_RECOVERY_MAX_PER_EMAIL=3
# AUTH_RECOVERY_MAX_GLOBAL=50
# AUTH_RECOVERY_WINDOW_SECONDS=900

# mock | azure. "azure" means every component is real and requires TRANSLATION_PROVIDER=azure,
# SPEECH_PROVIDER=azure and AUDIO_PROCESSOR=ffmpeg (with their credentials and FFmpeg): the app
# refuses to start otherwise, it never falls back to a mock. "mock" allows any mix below.
PROVIDER_MODE=mock
# Translation can already be real while audio processing stays mock: mock | azure.
# With azure, AZURE_TRANSLATOR_KEY is required and the transcript text is sent to Azure.
TRANSLATION_PROVIDER=mock
# --- Azure Translator (only read when TRANSLATION_PROVIDER=azure) ---
# Secret: set it in backend/.env (git-ignored) or the host's secret settings, never in Git.
# AZURE_TRANSLATOR_KEY=
# Region shown on the resource's "Keys and Endpoint" page; omit for a Global resource.
# AZURE_TRANSLATOR_REGION=
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# AZURE_TRANSLATOR_TIMEOUT_SECONDS=30
# Largest request including markup (service limit: 50000; shorter is recommended).
# AZURE_TRANSLATOR_MAX_REQUEST_CHARS=10000
# Speech can be real while the other components stay mock: mock | azure. With azure,
# AZURE_SPEECH_KEY and AZURE_SPEECH_REGION are required, ffmpeg and ffprobe must be on PATH
# (they are in the Docker image), and the (translated) text is sent to Azure Speech. The
# Translator key is never used for speech.
SPEECH_PROVIDER=mock
# Audio processing: mock (pass-through, duration NOT adjusted) | ffmpeg (the speech audio is
# sped up or slowed down as a whole to last exactly the target duration; pitch is preserved).
# ffmpeg needs SPEECH_PROVIDER=azure, ffmpeg/ffprobe on PATH with the atempo filter and the
# libmp3lame encoder (all in the Docker image); startup fails otherwise. No Azure call is made.
AUDIO_PROCESSOR=mock
# --- Azure Speech (only read when SPEECH_PROVIDER=azure) ---
# AZURE_SPEECH_KEY=
# Region of the Speech resource (lowercase, e.g. westus2); selects the regional TTS endpoint.
# AZURE_SPEECH_REGION=
# AZURE_SPEECH_TIMEOUT_SECONDS=60
# Largest text per request. The service silently cuts audio at 10 minutes per request.
# AZURE_SPEECH_MAX_CHUNK_CHARS=2000
# Request rate shared by all jobs. Defaults are the Free (F0) limit: 20 per 60 seconds.
# AZURE_SPEECH_MAX_REQUESTS_PER_WINDOW=20
# AZURE_SPEECH_RATE_WINDOW_SECONDS=60
# YouTube caption import into the form: off (default; pasting only) | supadata (the English
# captions the video already has, fetched by Supadata with mode=native: no audio download, no
# speech-to-text, no translation) | mock (fixed captions, no network; refused in production).
# The video link is sent to Supadata. supadata needs SUPADATA_API_KEY; startup fails without it.
# It never creates a job: the user reviews the transcript and chooses Generate audio.
YOUTUBE_IMPORT_PROVIDER=off
# --- Supadata (only read when YOUTUBE_IMPORT_PROVIDER=supadata) ---
# Backend only: never in the frontend, the repository, logs or chat. Each import costs 1 credit
# (Free plan: 100 credits/month); status polls of an asynchronous job are free.
# SUPADATA_API_KEY=
# Time for one HTTP request, and for a whole import including the polls of a job.
# SUPADATA_TIMEOUT_SECONDS=30
# SUPADATA_DEADLINE_SECONDS=90
# SUPADATA_POLL_INTERVAL_SECONDS=1
# Request rate shared by every import, polls included. Defaults are the Free plan (1 per second).
# SUPADATA_MAX_REQUESTS_PER_WINDOW=1
# SUPADATA_RATE_WINDOW_SECONDS=1
# Imports at the same time; one more gets 503 youtube_import_busy (not a usage quota).
# YOUTUBE_IMPORT_MAX_CONCURRENT=2
# "Try as guest" (docs/GUEST_ACCESS.md): people without an invitation use the Studio with a guest
# session and quotas (5 completed jobs per guest session, 20 per client network per 24 hours,
# 1,000 words per job). Needs AUTH_MODE=cognito; in production also CLIENT_IP_HEADER. Off by default.
GUEST_ACCESS_ENABLED=false
# --- Guest access (only read when GUEST_ACCESS_ENABLED=true) ---
# Keys the hash that identifies a client network (no raw IP is stored). Its own secret: 32 random
# bytes, URL-safe base64; never AUTH_TOKEN_ENCRYPTION_KEY. Generate:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# GUEST_IP_HASH_KEY=
# Absolute lifetime of a guest session and its cookie (never extended; at most the IP window).
# GUEST_SESSION_TTL_SECONDS=86400
# GUEST_JOBS_PER_SESSION=5
# GUEST_JOBS_PER_IP=20
# GUEST_IP_WINDOW_SECONDS=86400
# GUEST_MAX_WORDS=1000
# Guest sessions that may be started per client network and overall, per window.
# GUEST_SESSIONS_PER_IP=10
# GUEST_SESSIONS_GLOBAL=300
# GUEST_SESSION_RATE_WINDOW_SECONDS=3600
# With APP_ENV=production, mock providers are refused unless this is true (online mock beta).
# Every other production rule (Secure cookies, 16+ char Access Code, ...) still applies.
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false
# Deterministic mock failure: none | translation | speech | audio | unexpected (non-production
# only). Each one only applies to the mock component it names.
MOCK_FAIL_STAGE=none
# Delay per mock stage so the processing stages are visible in the UI.
MOCK_STAGE_DELAY_SECONDS=1.5

# Sessions. COOKIE_SECURE must be true in production (HTTPS); false only for local HTTP.
SESSION_TTL_SECONDS=43200
COOKIE_SECURE=false
# Extra origins allowed for state-changing requests (JSON list). Needed for the Vite dev server.
TRUSTED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Sign-in brute-force protection (failed Access Code or email/password attempts per sliding window).
# Header the edge proxy overwrites with the real client IP (e.g. cf-connecting-ip on Render).
# Leave unset locally. Guest quotas use it strictly: a missing or malformed value refuses guests.
# CLIENT_IP_HEADER=
ACCESS_MAX_FAILURES_PER_CLIENT=5
ACCESS_MAX_FAILURES_GLOBAL=50
ACCESS_FAILURE_WINDOW_SECONDS=900

# Job execution capacity (resource-based, not a usage quota).
JOB_MAX_CONCURRENCY=2
JOB_MAX_QUEUED=8
# Job liveness: heartbeat interval, staleness threshold (>= 3x interval) after which another
# instance fails the job as interrupted, and shutdown grace for running jobs.
JOB_HEARTBEAT_INTERVAL_SECONDS=15
JOB_STALE_AFTER_SECONDS=90
JOB_SHUTDOWN_GRACE_SECONDS=20

# Temporary results (translation text + MP3) on local disk.
RESULT_TTL_SECONDS=3600
# RESULT_STORAGE_DIR=/tmp/mydubb-results
CLEANUP_INTERVAL_SECONDS=300

# Request body guard protecting the instance's memory (bytes).
MAX_REQUEST_BODY_BYTES=10485760

# Serve the built React app from FastAPI (set automatically in the Docker image).
# FRONTEND_DIST_DIR=../frontend/dist

LOG_LEVEL=INFO

# Container only: trusted proxy IPs for X-Forwarded-For ("*" behind Render's proxy).
# FORWARDED_ALLOW_IPS=127.0.0.1
# RUN_MIGRATIONS_ON_START=true
