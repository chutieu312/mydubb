# MyDubb configuration. PLACEHOLDERS ONLY - never commit real values.
# Local development: copy to backend/.env (read by the backend from its working directory).
# Docker Compose: only ACCESS_CODE is read from your shell or a root .env file.

# development | test | production
APP_ENV=development

# PostgreSQL only (no SQLite fallback). Neon URLs (postgresql://...?sslmode=require) work as-is.
# Use 127.0.0.1 rather than localhost on Windows (avoids IPv6 resolution to ::1).
DATABASE_URL=postgresql://mydubb:mydubb_local@127.0.0.1:5432/mydubb
DB_CONNECT_TIMEOUT_SECONDS=10

# Private Beta Access Code (server-side only). >= 8 chars; >= 16 chars in production.
ACCESS_CODE=replace-with-a-long-random-code

# Only "mock" is accepted: audio processing is still a mock until FFmpeg duration fitting
# (Milestone 3C). "azure" (everything real) is rejected until then.
PROVIDER_MODE=mock
# Translation can already be real while audio processing stays mock: mock | azure.
# With azure, AZURE_TRANSLATOR_KEY is required and the transcript text is sent to Azure.
TRANSLATION_PROVIDER=mock
# --- Azure Translator (only read when TRANSLATION_PROVIDER=azure) ---
# Secret: set it in backend/.env (git-ignored) or the host's secret settings, never in Git.
# AZURE_TRANSLATOR_KEY=
# Region shown on the resource's "Keys and Endpoint" page; omit for a Global resource.
# AZURE_TRANSLATOR_REGION=
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# AZURE_TRANSLATOR_TIMEOUT_SECONDS=30
# Largest request including markup (service limit: 50000; shorter is recommended).
# AZURE_TRANSLATOR_MAX_REQUEST_CHARS=10000
# Speech can be real while audio processing stays a pass-through (no duration fitting yet):
# mock | azure. With azure, AZURE_SPEECH_KEY and AZURE_SPEECH_REGION are required, ffmpeg and
# ffprobe must be on PATH (they are in the Docker image), and the (translated) text is sent
# to Azure Speech. The Translator key is never used for speech.
SPEECH_PROVIDER=mock
# --- Azure Speech (only read when SPEECH_PROVIDER=azure) ---
# AZURE_SPEECH_KEY=
# Region of the Speech resource (lowercase, e.g. westus2); selects the regional TTS endpoint.
# AZURE_SPEECH_REGION=
# AZURE_SPEECH_TIMEOUT_SECONDS=60
# Largest text per request. The service silently cuts audio at 10 minutes per request.
# AZURE_SPEECH_MAX_CHUNK_CHARS=2000
# Request rate shared by all jobs. Defaults are the Free (F0) limit: 20 per 60 seconds.
# AZURE_SPEECH_MAX_REQUESTS_PER_WINDOW=20
# AZURE_SPEECH_RATE_WINDOW_SECONDS=60
# With APP_ENV=production, mock providers are refused unless this is true (online mock beta).
# Every other production rule (Secure cookies, 16+ char Access Code, ...) still applies.
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false
# Deterministic mock failure: none | translation | speech | audio | unexpected (non-production only)
MOCK_FAIL_STAGE=none
# Delay per mock stage so the processing stages are visible in the UI.
MOCK_STAGE_DELAY_SECONDS=1.5

# Sessions. COOKIE_SECURE must be true in production (HTTPS); false only for local HTTP.
SESSION_TTL_SECONDS=43200
COOKIE_SECURE=false
# Extra origins allowed for state-changing requests (JSON list). Needed for the Vite dev server.
TRUSTED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Access Code brute-force protection (failed attempts per sliding window).
# Header the edge proxy overwrites with the real client IP (e.g. cf-connecting-ip on Render).
# Leave unset locally.
# CLIENT_IP_HEADER=
ACCESS_MAX_FAILURES_PER_CLIENT=5
ACCESS_MAX_FAILURES_GLOBAL=50
ACCESS_FAILURE_WINDOW_SECONDS=900

# Job execution capacity (resource-based, not a usage quota).
JOB_MAX_CONCURRENCY=2
JOB_MAX_QUEUED=8
# Job liveness: heartbeat interval, staleness threshold (>= 3x interval) after which another
# instance fails the job as interrupted, and shutdown grace for running jobs.
JOB_HEARTBEAT_INTERVAL_SECONDS=15
JOB_STALE_AFTER_SECONDS=90
JOB_SHUTDOWN_GRACE_SECONDS=20

# Temporary results (translation text + MP3) on local disk.
RESULT_TTL_SECONDS=3600
# RESULT_STORAGE_DIR=/tmp/mydubb-results
CLEANUP_INTERVAL_SECONDS=300

# Request body guard protecting the instance's memory (bytes).
MAX_REQUEST_BODY_BYTES=10485760

# Serve the built React app from FastAPI (set automatically in the Docker image).
# FRONTEND_DIST_DIR=../frontend/dist

LOG_LEVEL=INFO

# Container only: trusted proxy IPs for X-Forwarded-For ("*" behind Render's proxy).
# FORWARDED_ALLOW_IPS=127.0.0.1
# RUN_MIGRATIONS_ON_START=true
