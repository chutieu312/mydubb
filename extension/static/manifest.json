{
  "manifest_version": 3,
  "name": "MyDubb Prototype",
  "version": "0.2.0",
  "description": "Prototype: send selected Udemy transcript text to a side panel, dub it with your MyDubb account and listen there.",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "sidePanel", "storage", "identity"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open MyDubb Prototype"
  },
  "content_scripts": [
    {
      "matches": ["https://www.udemy.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
